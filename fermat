#include <bits/stdc++.h>

using namespace std;

#define endl '\n'
#define ll long long

const ll MOD = 1e9+7;

ll fact[400];

ll fexp(ll a, ll b) // Exponenciação rápida
{
    ll res = 1;
    while (b > 0) {
        if (b & 1) res = (res * a) % MOD;
        a = (a * a) % MOD;
        b >>= 1;
    }
    return res;
}

ll inv(ll x)
{
    return fexp(x, MOD-2);
}

ll mult(ll a, ll b)
{
    return ((a * b) % MOD);
}

ll comb(ll n, ll k)
{
    return mult(fact[n], inv(mult(fact[k], fact[n-k])));
}

void calc_fact()
{
    fact[0] = fact[1] = 1;
    for (int i=2; i<400; i++) {
        fact[i] = (i * fact[i-1]) % MOD;
    }
}

int main()
{
    ios_base::sync_with_stdio(false); cin.tie(NULL);

    calc_fact();

    int t; cin >> t;
    while (t--) {
        ll n, x;
        cin >> n >> x;
        if ((n - x) >= 365) {
            cout << 0 << endl;
        } else {
            ll ans = 1;
            for (ll i=x+1; i<=n; i++) ans = mult(ans, (i % MOD)); // n!/x!
            ans = mult(ans, comb(364, (n-x)));
            ans = mult(ans, inv(fexp(365, n-1)));
            cout << ans << endl;
        }
    }
}
