#include <iostream>
#include <vector>

using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    if (!(cin >> n)) return 0;

    vector<int> t(n + 1);
    for (int i = 1; i <= n; i++) {
        cin >> t[i];
    }

    vector<int> ans(n + 1, 0);
    vector<int> state(n + 1, 0); 

    for (int i = 1; i <= n; i++) {
        if (state[i] != 0) continue;

        vector<int> path;
        int curr = i;

        // Avança até encontrar um planeta já visitado na travessia atual ou numa anterior
        while (state[curr] == 0) {
            state[curr] = 1;
            path.push_back(curr);
            curr = t[curr];
        }

        if (state[curr] == 1) { 
            // Novo ciclo detetado
            int cycle_start_idx = -1;
            for (int j = 0; j < path.size(); j++) {
                if (path[j] == curr) {
                    cycle_start_idx = j;
                    break;
                }
            }
            
            int cycle_len = path.size() - cycle_start_idx;
            
            // Planetas no ciclo partilham o mesmo comprimento
            for (int j = cycle_start_idx; j < path.size(); j++) {
                ans[path[j]] = cycle_len;
            }
            // Planetas na ramificação que leva ao ciclo
            for (int j = cycle_start_idx - 1; j >= 0; j--) {
                ans[path[j]] = ans[t[path[j]]] + 1;
            }
        } else if (state[curr] == 2) { 
            // Interceção com um caminho ou ciclo já processado
            for (int j = path.size() - 1; j >= 0; j--) {
                ans[path[j]] = ans[t[path[j]]] + 1;
            }
        }

        // Marcar todos os planetas do caminho atual como processados
        for (int p : path) {
            state[p] = 2;
        }
    }

    for (int i = 1; i <= n; i++) {
        cout << ans[i] << (i == n ? "" : " ");
    }
    cout << "\n";

    return 0;
}